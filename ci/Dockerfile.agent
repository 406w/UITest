FROM node:24-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6 AS node
FROM jenkins/inbound-agent:bookworm-jdk21@sha256:8b0e951edcdd179774e07177e5afca6dc51548fc8de8ee8d05574de0ae8ea855
USER root
ARG ALLURE_VERSION=2.45.0
COPY --from=node /usr/local/bin/node /usr/local/bin/node
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv git curl ca-certificates \
    && curl -fsSL "https://github.com/allure-framework/allure2/releases/download/${ALLURE_VERSION}/allure-${ALLURE_VERSION}.tgz" -o /tmp/allure.tgz \
    && mkdir -p /opt/allure \
    && tar -xzf /tmp/allure.tgz -C /opt/allure --strip-components=1 \
    && rm /tmp/allure.tgz \
    && rm -rf /var/lib/apt/lists/*
ENV ALLURE_CLI=/opt/allure/bin/allure PYTHONUTF8=1 PYTHONUNBUFFERED=1
COPY --chmod=755 ci/agent-entrypoint.sh /usr/local/bin/erp-agent
USER jenkins
ENTRYPOINT ["/usr/local/bin/erp-agent"]
